# DeepSeek
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com

# Default model, format: provider/model
TINY_DSH_MODEL=deepseek/deepseek-v4-flash

# Directory the agent works in; defaults to the process cwd.
# TINY_DSH_WORKSPACE=/absolute/path/to/project

# JSONL session directory; defaults to ./sessions.
# TINY_DSH_SESSIONS=sessions

# Estimated-token threshold that triggers compaction; defaults to 8000.
# TINY_DSH_MAX_TOKENS=8000

# Permission preset at boot: workspace-write | danger-full-access; defaults to workspace-write.
# TINY_DSH_PERMISSION=workspace-write

# Skip the [Y/n] approval prompt (tests / non-interactive runs only).
# TINY_DSH_AUTO_APPROVE=0
